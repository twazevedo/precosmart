# ─── PreçoSmart WhatsApp Bot — Variáveis de Ambiente ───────────────────────
#
# Copie este arquivo como .env e preencha com seus dados reais.
# No Render.com, configure estas mesmas variáveis em:
#   Dashboard → Seu Serviço → Environment → Add Environment Variable
#
# NUNCA commite o arquivo .env no Git!

# Porta do servidor web (Render define automaticamente)
PORT=3002

# Grupo VIP Oficial de Destino
WA_GROUP_NAME="PreçoSmart Ofertas 🔥"
WA_GROUP_INVITE_CODE="codigo_convite_aqui"
WA_GROUP_JID="120363428098199018@g.us"

# Números dos Administradores/Donos (separados por vírgula)
OWNER_NUMBER="5511945868954,5511913157990"

# Persistência de Autenticação WhatsApp (MongoDB Atlas Gratuito)
# Necessário no Render para manter conectado sem pedir QR Code a cada deploy
MONGO_URI="mongodb+srv://usuario:senha@cluster0.mongodb.net/?retryWrites=true&w=majority"

# Automação Instagram (Make.com Webhook)
INSTAGRAM_WEBHOOK_URL="https://hook.make.com/seu_webhook_aqui"

# Credenciais Oficiais de Afiliados
AFFILIATE_AMAZON="precosmartapp-20"
AFFILIATE_ML="azs5603820"
AFFILIATE_SHOPEE="18361251220"
AFFILIATE_MAGALU="precosmartvip"

# Códigos de convite dos canais concorrentes monitorados (opcional, separados por vírgula)
SOURCE_INVITE_CODES=""
