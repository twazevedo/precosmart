# ─── PreçoSmart WhatsApp Bot — Variáveis de Ambiente ───────────────────────
#
# Copie este arquivo como .env e preencha os valores.
# No Render.com, configure estas variáveis em:
#   Dashboard → Seu Serviço → Environment → Add Environment Variable
#
# NUNCA commite o arquivo .env no Git!

# Porta do servidor web (Render.com define automaticamente)
PORT=3002

# Nome EXATO do grupo no WhatsApp (case-sensitive, incluindo emojis)
WA_GROUP_NAME=PreçoSmart Ofertas 🔥

# Código do convite do grupo (parte final da URL chat.whatsapp.com/XXXXXX)
# Link original: https://chat.whatsapp.com/CtvhryCwxWVGx0DCud42XO
WA_GROUP_INVITE_CODE=CtvhryCwxWVGx0DCud42XO
