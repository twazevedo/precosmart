# ─── PreçoSmart WhatsApp Bot — Variáveis de Ambiente ───────────────────────
#
# Copie este arquivo como .env e preencha com seus dados reais.
# No Render.com, configure estas mesmas variáveis em:
#   Dashboard → Seu Serviço → Environment → Add Environment Variable
#
# NUNCA commite o arquivo .env no Git!

# Porta do servidor web (Render define automaticamente)
PORT=3002

# Grupo VIP Oficial de Destino
WA_GROUP_NAME="PreçoSmart Ofertas 🔥"
WA_GROUP_INVITE_CODE="codigo_convite_aqui"
WA_GROUP_JID="id_do_grupo@g.us"

# Automação Instagram (Make.com Webhook)
INSTAGRAM_WEBHOOK_URL="https://hook.make.com/seu_webhook_aqui"

# Credenciais Oficiais de Afiliados
AFFILIATE_AMAZON="suatag-20"
AFFILIATE_ML="suatag_ml"
AFFILIATE_SHOPEE="suatag_shopee"
AFFILIATE_MAGALU="suatag_magalu"
